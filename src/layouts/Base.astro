---
import "@/src/styles.css";
import { resolveTheme } from "@/lib/theme";
import { themeCss } from "@/src/themes";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Serlis Maldonado — Desarrollo de Software, IA y Herramientas",
  description = "Desarrollo de software, inteligencia artificial y herramientas para negocios.",
  image = "/serlis.jpg",
} = Astro.props;
const theme = await resolveTheme(Astro);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es" class="dark" data-theme={theme.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.themeColor} />
    {themeCss(theme) && <style set:html={themeCss(theme)} />}
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
