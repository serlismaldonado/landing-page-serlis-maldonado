---
import Base from "@/src/layouts/Base.astro";
import { SendButton } from "@/components/admin/SendButton";
import { getAllPosts } from "@/lib/blog";
import { requireAdminPage } from "./_guard";

const redirect = await requireAdminPage(Astro);
if (redirect) return redirect;
const posts = await getAllPosts();
---

<Base title="Newsletter — Serlis Maldonado">
  <meta name="robots" content="noindex" slot="head" />

    <div class="bg-zinc-950 min-h-screen">
      <div class="max-w-2xl mx-auto px-6 py-16">
        <div class="mb-10">
          <a
            href="/admin"
            class="font-mono text-xs text-zinc-600 hover:text-zinc-400 transition-colors mb-8 inline-block"
          >
            ← admin
          </a>
          <h1 class="text-2xl font-bold text-white tracking-tight mb-1">
            Newsletter
          </h1>
          <p class="text-sm text-zinc-500">
            Envía un post del blog a todos los suscriptores.
          </p>
        </div>

        {posts.length === 0 ? (
          <p class="font-mono text-sm text-zinc-600">
            No hay posts publicados.
          </p>
        ) : (
          <ul class="divide-y divide-zinc-900">
            {posts.map(({ slug, metadata }) => (
              <li class="py-5 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="font-mono text-[11px] text-zinc-600 mb-0.5 uppercase tracking-wide">
                    {metadata.date}
                  </p>
                  <p class="text-sm font-medium text-zinc-200 truncate">
                    {metadata.title}
                  </p>
                  {metadata.tags && metadata.tags.length > 0 && (
                    <div class="flex gap-1.5 mt-1">
                      {metadata.tags.map((tag) => (
                        <span
                          
                          class="font-mono text-[10px] text-zinc-700 border border-zinc-800 px-1.5 py-0.5 rounded"
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <SendButton client:load slug={slug} title={metadata.title} />
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
</Base>
