---
import Base from "@/src/layouts/Base.astro";
import Hero from "@/src/components/Hero.astro";
import SearchGridIsland from "@/src/islands/SearchGridIsland";
import ContributionGraph from "@/components/ContributionGraph";
import ContactLinks from "@/components/home/ContactLinks";
import { BlogSection } from "@/components/home/BlogSection";
import { getAllPosts } from "@/lib/blog";

// Si Notion falla, la home sigue cargando sin la sección de blog.
const posts = await getAllPosts().catch(() => []);
// La home cambia poco: el CDN la guarda 1 min y la refresca en segundo plano.
Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=600");
---

<Base>
  <div class="bg-zinc-950 font-sans">
    <Hero />

    <section id="proyectos" class="scroll-mt-6 bg-gradient-to-b from-zinc-950/40 to-zinc-950/30 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 font-mono text-xl text-white sm:text-2xl">Proyectos</h2>
          <p class="mx-auto max-w-2xl font-mono text-sm text-zinc-500">
            Explora mis proyectos y contribuciones técnicas
          </p>
        </div>
        <SearchGridIsland client:visible />
      </div>
    </section>

    <BlogSection posts={posts} />

    <section class="bg-gradient-to-b from-zinc-900/30 to-zinc-900/20 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 font-mono text-xl text-white sm:text-2xl">
            <span class="text-green-500">$</span> git log --oneline
          </h2>
          <p class="mx-auto max-w-2xl font-mono text-sm text-zinc-500">
            Mi actividad y contribuciones recientes
          </p>
        </div>
        <ContributionGraph client:visible />
      </div>
    </section>

    <section class="bg-gradient-to-b from-zinc-950/30 to-zinc-950/50 px-6 py-16">
      <div class="mx-auto max-w-6xl text-center">
        <h2 class="mb-4 font-mono text-xl text-white sm:text-2xl">
          <span class="text-green-500">$</span> ./connect.sh
        </h2>
        <p class="mx-auto mb-8 max-w-2xl font-mono text-sm text-zinc-500">
          Conéctate conmigo a través de estos canales
        </p>
        <ContactLinks />
      </div>
    </section>
  </div>
</Base>
