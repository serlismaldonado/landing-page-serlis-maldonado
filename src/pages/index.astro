---
import Base from "@/src/layouts/Base.astro";
import Hero from "@/src/components/Hero.astro";
import { getAllPosts } from "@/lib/blog";
import { api } from "@/convex/_generated/api";
import { publicQuery } from "@/lib/auth-server";

// Si Notion o Convex fallan, la home sigue cargando sin esas listas.
const [posts, projects] = await Promise.all([
  getAllPosts().catch(() => []),
  publicQuery(api.projects.queries.getAllProjects, {}).catch(() => []),
]);
// La home cambia poco: el CDN la guarda 1 min y la refresca en segundo plano.
Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=600");
---

<Base>
  <div class="bg-zinc-950 font-sans">
    <Hero posts={posts} projects={projects} />
  </div>
</Base>
